# HOMEY — variables d'environnement (Sprint 6 — secrets hors du code)
# Copier vers .env (jamais commité) puis adapter les valeurs.
# Le backend lit ces variables directement (os.environ) ; en production,
# définir HOMEY_DEBUG=0 et remplacer SECRET_KEY par une valeur générée :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Clé de signature JWT/Django (OBLIGATOIRE en production)
HOMEY_SECRET_KEY=

# 0 en production (active HSTS, SSL redirect, cookies HttpOnly, X-Frame-Options DENY)
HOMEY_DEBUG=1

# Hôte(s) autorisé(s), séparés par des virgules (ex: homey.tn,www.homey.tn)
HOMEY_ALLOWED_HOSTS=*

# Cache Redis en production (laisser vide en dev → locmem)
# HOMEY_REDIS_URL=redis://127.0.0.1:6379/1
HOMEY_REDIS_URL=

# Dossier des modèles ML entraînés (F6/F7)
# HOMEY_MODELE_DIR=/app/ml/modeles

# Production (docker-compose.yml) — base PostgreSQL
HOMEY_DB_HOST=
HOMEY_DB_PORT=5432
HOMEY_DB_NAME=homey
HOMEY_DB_USER=homey
HOMEY_DB_PASSWORD=

# Monitoring erreurs (optionnel — sentry.io, US10.4)
HOMEY_SENTRY_DSN=
